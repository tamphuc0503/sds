{
	"name": "sds-django",
	"dockerComposeFile": "docker-compose.yaml",
	"service": "sds-django",
	"workspaceFolder": "/app",
	"shutdownAction": "stopCompose",
	// "forwardPorts": [5432],
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.profiles.linux": {
					"bash": {
						"path": "bash",
						"icon": "terminal-bash"
					}
				}
			},
			"extensions": [
				"donjayamanne.python-extension-pack",
				"littlefoxteam.vscode-python-test-adapter",
				"humao.rest-client",
				"postman.postman-for-vscode",
				"njpwerner.autodocstring",
				"ms-python.black-formatter"
			]
		}
	},
	"postCreateCommand": "python3 -m venv venv && source ./venv/bin/activate && pip3 install -r requirements.txt"
}